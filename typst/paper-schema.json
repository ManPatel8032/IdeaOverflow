{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paper Document Schema",
  "description": "Schema for a nested research paper document tree. Paper → Sections → Subsections → Paragraphs / Equations.",
  "type": "object",
  "definitions": {
    "paragraph": {
      "type": "object",
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "type": "string", "description": "The text content of the paragraph." }
      },
      "required": ["type", "text"]
    },
    "equation": {
      "type": "object",
      "properties": {
        "type": { "const": "equation" },
        "math": { "type": "string", "description": "The mathematical expression." }
      },
      "required": ["type", "math"]
    },
    "image": {
      "type": "object",
      "properties": {
        "type": { "const": "image" },
        "src": { "type": "string" },
        "caption": { "type": "string" },
        "width": { "type": "string" }
      },
      "required": ["type"]
    },
    "table": {
      "type": "object",
      "properties": {
        "type": { "const": "table" },
        "columns": { "type": "integer" },
        "caption": { "type": "string" },
        "headers": { "type": "array", "items": { "type": "string" } },
        "data": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      },
      "required": ["type"]
    },
    "subsubsection": {
      "type": "object",
      "properties": {
        "type": { "const": "subsubsection" },
        "title": { "type": "string", "description": "Title of the subsubsection." },
        "content": {
          "type": "array",
          "description": "Content items inside this subsubsection.",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/paragraph" },
              { "$ref": "#/definitions/equation" },
              { "$ref": "#/definitions/image" },
              { "$ref": "#/definitions/table" }
            ]
          }
        }
      },
      "required": ["type", "title", "content"]
    },
    "subsection": {
      "type": "object",
      "properties": {
        "type": { "const": "subsection" },
        "title": { "type": "string", "description": "Title of the subsection." },
        "content": {
          "type": "array",
          "description": "Content items inside this subsection.",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/paragraph" },
              { "$ref": "#/definitions/equation" },
              { "$ref": "#/definitions/image" },
              { "$ref": "#/definitions/table" },
              { "$ref": "#/definitions/subsubsection" }
            ]
          }
        }
      },
      "required": ["type", "title", "content"]
    },
    "section": {
      "type": "object",
      "properties": {
        "type": { "const": "section" },
        "title": { "type": "string", "description": "Title of the section (e.g. Introduction, Methodology)." },
        "content": {
          "type": "array",
          "description": "Content items inside this section.",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/paragraph" },
              { "$ref": "#/definitions/equation" },
              { "$ref": "#/definitions/image" },
              { "$ref": "#/definitions/table" },
              { "$ref": "#/definitions/subsection" }
            ]
          }
        }
      },
      "required": ["type", "title", "content"]
    }
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "The main title of the research paper."
    },
    "abstract": {
      "type": "string",
      "description": "A brief summary of the research paper."
    },
    "index_terms": {
      "type": "array",
      "description": "Keywords or index terms for the paper.",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "authors": {
      "type": "array",
      "description": "List of authors contributing to the paper.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Full name of the author." },
          "department": { "type": "string", "description": "Author's department." },
          "organization": { "type": "string", "description": "Author's university or company." },
          "location": { "type": "string", "description": "City and Country." },
          "email": { "type": "string", "format": "email", "description": "Contact email." }
        },
        "required": ["name"]
      },
      "minItems": 1
    },
    "content": {
      "type": "array",
      "description": "Top-level content array containing section objects.",
      "items": { "$ref": "#/definitions/section" },
      "minItems": 1
    },
    "references": {
      "type": "array",
      "description": "List of references cited in the paper.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "citation": { "type": "string" }
        },
        "required": ["id", "citation"]
      }
    }
  },
  "required": ["title", "authors", "content"]
}